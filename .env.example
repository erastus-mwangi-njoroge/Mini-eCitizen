# Copy to .env and edit. Every value is optional in development.
PORT=3000



# Where the database (db.json), uploaded photos and the session secret live.
# DATA_DIR=./data

# First staff account, created on first run if none exists. The email MUST end in @muranga.go.ke.
ADMIN_EMAIL=admin@muranga.go.ke
ADMIN_PASSWORD=ChangeMe123

# Code new staff must enter to create a staff account (required in production, otherwise staff sign-up is closed).
STAFF_ACCESS_CODE=MURANGA-STAFF

# Long random string used to sign login cookies. Empty = generated once and stored in the data folder.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Production: set NODE_ENV=production (requires ADMIN_PASSWORD, enables Secure cookies; serve over HTTPS).
# NODE_ENV=production

MAX_IMAGE_MB=5
RATE_LIMIT=20

# --- Password-reset email via Brevo (free plan: 300 emails/day) ---
# Empty = the reset link is printed in the server console (development only).
BREVO_API_KEY=
# Must be a sender you verified in Brevo (Senders, domains & dedicated IPs > Senders).
MAIL_FROM_EMAIL=erastusstevens@gmail.com
MAIL_FROM_NAME=Murang'a County Service Requests
# Public address of the site, used in the emailed link. On Render, RENDER_EXTERNAL_URL is used automatically.
PUBLIC_URL=https://murangaservices.onrender.com/

